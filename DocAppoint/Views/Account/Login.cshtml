@using DocAppoint.ViewModel
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
@section Styles {
    <link href="~/css/Login.css" rel="stylesheet" asp-append-version="true" />
}

<section class="login-section">
    <div class="login-bg-grid"></div>
    <div class="login-blob blob-1"></div>
    <div class="login-blob blob-2"></div>

    <div class="container login-container">
        <div class="login-card">
            <div class="card-top">
                <div class="top-icon">
                    <i class="bi bi-box-arrow-in-right"></i>
                </div>
                <h2>Welcome Back</h2>
                <p>Login to your DocAppoint account</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert-modern alert-success">
                    <div class="alert-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div class="alert-content">
                        <strong>Success</strong>
                        <span>@TempData["Success"]</span>
                    </div>
                    <button type="button" class="alert-close" onclick="this.parentElement.style.display='none'">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            <form method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="alert-modern alert-error"></div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-options">
                    <label class="checkbox-wrap">
                        <input asp-for="RememberMe" type="checkbox" />
                        Remember Me
                    </label>
                    <a class="forgot-link" href="#">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-login-submit">
                    Login <i class="bi bi-arrow-up-right"></i>
                </button>

                <div class="form-footer">
                    Don't have an account? <a asp-controller="Account" asp-action="Register">Create Account</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}