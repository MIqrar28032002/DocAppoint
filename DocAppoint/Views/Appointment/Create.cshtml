@model DocAppoint.Models.Appointment
@{
    ViewData["Title"] = "Book Appointment";
}
@if (TempData["Success"] != null)
{
    <div class="alert-modern alert-success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-modern alert-error">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}
@section Styles {
    <link href="~/css/Dashboard/Book.css" rel="stylesheet" asp-append-version="true" />
}

<div class="book-page">
    <div class="container book-container">
        <div class="book-header">
            <div class="book-icon"><i class="bi bi-calendar-plus"></i></div>
            <div>
                <h1>Book Appointment</h1>
                <p>Choose disease and doctor, confirm in seconds</p>
            </div>
        </div>

        <form asp-action="Create" class="book-form">
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="PatientName" class="form-label">Patient Name</label>
                    <div class="input-wrap">
                        <i class="bi bi-person"></i>
                        <input asp-for="PatientName" class="form-control" value="@User.Identity!.Name" placeholder="Full name" />
                    </div>
                    <span asp-validation-for="PatientName" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PatientPhone" class="form-label">Phone Number</label>
                    <div class="input-wrap">
                        <i class="bi bi-telephone"></i>
                        <input asp-for="PatientPhone" class="form-control" placeholder="03XX XXXXXXX" />
                    </div>
                    <span asp-validation-for="PatientPhone" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="PatientEmail" class="form-label">Email Address</label>
                <div class="input-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="PatientEmail" class="form-control" value="@User.Identity!.Name" placeholder="email@example.com" />
                </div>
                <span asp-validation-for="PatientEmail" class="field-error"></span>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Disease" class="form-label">Select Disease</label>
                    <div class="input-wrap">
                        <i class="bi bi-heart-pulse"></i>
                        <select asp-for="Disease" class="form-control">
                            <option value="">Choose disease</option>
                            <option value="Cardiology">Cardiology - Heart</option>
                            <option value="Dermatology">Dermatology - Skin</option>
                            <option value="Neurology">Neurology - Brain</option>
                            <option value="Orthopedics">Orthopedics - Bones</option>
                            <option value="ENT">ENT - Ear Nose Throat</option>
                            <option value="General Checkup">General Checkup</option>
                        </select>
                    </div>
                    <span asp-validation-for="Disease" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DoctorName" class="form-label">Select Doctor</label>
                    <div class="input-wrap">
                        <i class="bi bi-person-badge"></i>
                        <select asp-for="DoctorName" class="form-control">
                            <option value="">Choose doctor</option>
                            <option value="Dr. Ahmed Khan - Cardiologist">Dr. Ahmed Khan - Cardiologist</option>
                            <option value="Dr. Sara Ali - Dermatologist">Dr. Sara Ali - Dermatologist</option>
                            <option value="Dr. Bilal Sheikh - Neurologist">Dr. Bilal Sheikh - Neurologist</option>
                            <option value="Dr. Ayesha Noor - Orthopedic">Dr. Ayesha Noor - Orthopedic</option>
                            <option value="Dr. Usman Tariq - ENT Specialist">Dr. Usman Tariq - ENT Specialist</option>
                            <option value="Dr. Fatima Javed - General Physician">Dr. Fatima Javed - General Physician</option>
                        </select>
                    </div>
                    <span asp-validation-for="DoctorName" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="AppointmentDate" class="form-label">Appointment Date</label>
                <div class="input-wrap">
                    <i class="bi bi-calendar-event"></i>
                    <input asp-for="AppointmentDate" type="date" class="form-control" />
                </div>
                <span asp-validation-for="AppointmentDate" class="field-error"></span>
            </div>

            <button type="submit" class="btn-book">
                Book Appointment <i class="bi bi-arrow-up-right"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}