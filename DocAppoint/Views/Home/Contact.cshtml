@{
    ViewData["Title"] = "Contact";
}
@section Styles {
    <link href="~/css/Contact.css" rel="stylesheet" asp-append-version="true" />
}

<section class="contact-section">
    <div class="contact-bg-grid"></div>
    <div class="contact-blob blob-1"></div>
    <div class="contact-blob blob-2"></div>

    <div class="container">
        <div class="contact-header">
            <div class="header-badge">
                <i class="bi bi-chat-dots-fill"></i> Get in Touch
            </div>
            <h1>Contact <span>DocAppoint</span></h1>
            <p>We are here to help you 24/7 - reach us anytime</p>
        </div>

        <div class="contact-grid">
            <div class="contact-card">
                <div class="card-icon icon-blue">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <h3>Our Location</h3>
                <p>Peshawar, Khyber Pakhtunkhwa<br>Pakistan, 100210</p>
                <a class="card-link" href="#"><i class="bi bi-arrow-up-right"></i> View on Map</a>
            </div>

            <div class="contact-card active">
                <div class="card-icon icon-dark">
                    <i class="bi bi-envelope-fill"></i>
                </div>
                <h3>Email Us</h3>
                <p>support@docappoint.com<br>info@docappoint.com</p>
                <a class="card-link" href="mailto:support@docappoint.com"><i class="bi bi-arrow-up-right"></i> Send Email</a>
            </div>

            <div class="contact-card">
                <div class="card-icon icon-green">
                    <i class="bi bi-telephone-fill"></i>
                </div>
                <h3>Call Us</h3>
                <p>+92 300 1234567<br>+92 91 1234567</p>
                <a class="card-link" href="tel:+923001234567"><i class="bi bi-arrow-up-right"></i> Call Now</a>
            </div>
        </div>

        <div class="contact-bottom">
            <div class="bottom-image">
                <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?q=80&w=600&auto=format&fit=crop" alt="Contact Support">
                <div class="image-overlay">
                    <span><i class="bi bi-clock-fill"></i> 24/7 Support Available</span>
                </div>
            </div>
            <div class="bottom-info">
                <h2>We Respond Within <span>30 Minutes</span></h2>
                <p>Our dedicated support team is always ready to assist you with appointments, doctors information and technical help.</p>
                <div class="info-list">
                    <div class="info-item"><i class="bi bi-check-circle-fill"></i> Instant reply on email</div>
                    <div class="info-item"><i class="bi bi-check-circle-fill"></i> Live chat support 24/7</div>
                    <div class="info-item"><i class="bi bi-check-circle-fill"></i> Phone support 9AM - 9PM</div>
                </div>
                <div class="social-links">
                    <a href="#"><i class="bi bi-whatsapp"></i></a>
                    <a href="#"><i class="bi bi-instagram"></i></a>
                    <a href="#"><i class="bi bi-linkedin"></i></a>
                    <a href="#"><i class="bi bi-twitter-x"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>